{
  "name": "ultracode-button",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:ext": "node scripts/build-extension.mjs",
    "build:desktop": "vite build --config desktop/vite.config.ts",
    "build:wc": "vite build --config packages/clawd-button/vite.config.ts",
    "desktop": "npm run build:desktop && electron .",
    "dist:desktop": "npm run build:desktop && electron-builder --win portable nsis",
    "icons": "python scripts/make-icons.py",
    "check:anims": "node scripts/check-anims.mjs",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "gifenc": "^1.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  },
  "main": "desktop/main.cjs",
  "description": "Pixel-art Clawd button widget: web component, browser extension and desktop widget",
  "build": {
    "appId": "com.clawd.buttonwidget",
    "productName": "Clawd Widget",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/assets/**",
      "dist-desktop/**",
      "package.json",
      "THIRD_PARTY_LICENSES.txt",
      "LICENSE"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "mac": {
      "icon": "desktop/assets/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "icon": "desktop/assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "electronDist": "node_modules/electron/dist"
  },
  "author": "Clawd Widget",
  "license": "MIT"
}
